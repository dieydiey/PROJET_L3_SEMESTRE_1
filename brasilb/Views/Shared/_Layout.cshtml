<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Brasil Burger</title>
    <link rel="stylesheet" href="~/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>
<body>
    <nav class="navbar">
        <div class="navbar-content">
            <div class="logo"><i class="fa-solid fa-burger"></i> BRASIL BURGER</div>
            <div class="nav-menu">
                <a asp-controller="Catalogue" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">Catalogue</a>
                
                @if (Context.Session.GetInt32("IdClient") != null)
                {
                    <a asp-controller="Commande" asp-action="MesCommandes" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "MesCommandes" ? "active" : "")">Mes Commandes</a>
                }
                
                <a href="#contact">Contact</a>
            </div>
            <div style="display: flex; gap: 20px; align-items: center;">
                <a asp-controller="Panier" asp-action="Index" class="cart-icon" style="position: relative; text-decoration: none;">
                    🛒
                    @{
                        var panier = Context.Session.GetObjectFromJson<BrasilBurger.Models.ViewModels.PanierViewModel>("Panier");
                        var nbArticles = panier?.Articles.Count ?? 0;
                    }
                    @if (nbArticles > 0)
                    {
                        <span class="cart-badge" style="position: absolute; top: -10px; right: -10px; background: red; color: white; border-radius: 50%; padding: 2px 6px; font-size: 12px;">@nbArticles</span>
                    }
                </a>
                
                @if (Context.Session.GetInt32("IdClient") != null)
                {
                    <div class="user-menu" style="display: flex; align-items: center; gap: 10px;">
                        <div class="user-avatar" style="width: 35px; height: 35px; background: #eee; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                            @(Context.Session.GetString("NomClient")?.Substring(0, 1).ToUpper() ?? "U")
                        </div>
                        <span>@Context.Session.GetString("NomClient")</span>
                    </div>
                    <a asp-controller="Compte" asp-action="Deconnexion" class="btn btn-secondary" style="padding: 8px 15px;">Déconnexion</a>
                }
                else
                {
                    <a asp-controller="Compte" asp-action="Connexion" class="btn btn-primary" style="padding: 8px 15px;">Connexion</a>
                }
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>