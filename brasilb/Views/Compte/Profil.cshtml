@{
    ViewData["Title"] = "Mon Profil";
    Layout = "_Layout";
}

<div class="container">
    <h1 style="font-size: 42px; margin-bottom: 40px;">👤 Mon Profil</h1>

    <div style="max-width: 800px; margin: 0 auto;">
        <div class="cart-container">
            <div style="text-align: center; margin-bottom: 40px;">
                <div class="user-avatar" style="width: 100px; height: 100px; font-size: 40px; margin: 0 auto 20px;">
                    @(Context.Session.GetString("NomClient")?.Substring(0, 2).ToUpper() ?? "U")
                </div>
                <h2 style="font-size: 28px; margin-bottom: 10px;">@Context.Session.GetString("NomClient")</h2>
                <p style="color: #757575;">@Context.Session.GetString("EmailClient")</p>
            </div>

            <div style="background: #f5f5f5; padding: 30px; border-radius: 15px; margin-bottom: 30px;">
                <h3 style="font-size: 20px; margin-bottom: 20px;">Informations personnelles</h3>
                
                <div style="display: grid; gap: 15px;">
                    <div style="display: flex; justify-content: space-between; padding: 15px; background: white; border-radius: 8px;">
                        <span style="color: #757575;">Nom complet</span>
                        <strong>@Context.Session.GetString("NomClient")</strong>
                    </div>

                    <div style="display: flex; justify-content: space-between; padding: 15px; background: white; border-radius: 8px;">
                        <span style="color: #757575;">Email</span>
                        <strong>@Context.Session.GetString("EmailClient")</strong>
                    </div>

                    <div style="display: flex; justify-content: space-between; padding: 15px; background: white; border-radius: 8px;">
                        <span style="color: #757575;">Statut</span>
                        <span class="status-badge status-ready">Client actif</span>
                    </div>
                </div>
            </div>

            <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
                <a asp-controller="Commande" asp-action="MesCommandes" class="btn btn-primary" style="padding: 15px 40px;">
                    📦 Mes commandes
                </a>
                <a asp-controller="Compte" asp-action="Deconnexion" class="btn btn-secondary" style="padding: 15px 40px;">
                    🚪 Déconnexion
                </a>
            </div>
        </div>
    </div>
</div>