{% extends 'base.html.twig' %}

{% block page_title %}
    <span class="d-inline-flex align-items-center justify-content-center rounded-circle me-2" style="width: 35px; height: 35px; background-color: #fef2f2;">
        <i class="bi bi-grid-1x2-fill text-danger fs-5"></i>
    </span>
    Tableau de Bord
{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold mb-0 text-dark">Rapport d'Activité</h1>
            <p class="text-muted small mb-0">
                <i class="bi bi-calendar3 me-1"></i> Aujourd'hui, {{ "now"|date('d F Y') }}
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('statistique_periode') }}" class="btn btn-white border shadow-sm rounded-3">
                <i class="bi bi-filter me-1"></i> Filtrer
            </a>
            <a href="{{ path('statistique_export') }}" class="btn btn-dark shadow-sm rounded-3">
                <i class="bi bi-download me-1"></i> Export
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-2">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-shrink-0 bg-primary-soft p-3 rounded-3 me-3">
                        <i class="bi bi-cart-fill text-primary fs-4"></i>
                    </div>
                    <div>
                        <h6 class="text-muted small mb-1">En cours</h6>
                        <span class="h4 fw-bold mb-0">{{ resume.commandesEnCours }}</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-2">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-shrink-0 bg-success-soft p-3 rounded-3 me-3">
                        <i class="bi bi-check-circle-fill text-success fs-4"></i>
                    </div>
                    <div>
                        <h6 class="text-muted small mb-1">Validées</h6>
                        <span class="h4 fw-bold mb-0">{{ resume.commandesValidees }}</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-2">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-shrink-0 bg-warning-soft p-3 rounded-3 me-3">
                        <i class="bi bi-cash-stack text-warning fs-4"></i>
                    </div>
                    <div>
                        <h6 class="text-muted small mb-1">Chiffre d'Affaire</h6>
                        <span class="h4 fw-bold mb-0">{{ resume.recettes|number_format(0, ',', ' ') }} <small class="fs-6">FCFA</small></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-2">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-shrink-0 bg-danger-soft p-3 rounded-3 me-3">
                        <i class="bi bi-x-circle-fill text-danger fs-4"></i>
                    </div>
                    <div>
                        <h6 class="text-muted small mb-1">Annulées</h6>
                        <span class="h4 fw-bold mb-0">{{ resume.commandesAnnulees }}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between">
                    <h5 class="fw-bold mb-0">Volumes de ventes</h5>
                    <span class="badge bg-light text-dark border">Temps réel</span>
                </div>
                <div class="card-body px-4 pb-4">
                    <canvas id="statsChart" style="max-height: 300px;"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0">🔥 Top Burgers</h5>
                </div>
                <div class="card-body px-4">
                    {% if resume.topVentes.burgers|length > 0 %}
                        <div class="list-group list-group-flush">
                            {% for index, burger in resume.topVentes.burgers %}
                                <div class="list-group-item px-0 border-0 d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center">
                                        <div class="rank-badge me-3 {% if index == 0 %}gold{% elseif index == 1 %}silver{% endif %}">
                                            {{ index + 1 }}
                                        </div>
                                        <span class="fw-medium text-dark">{{ burger.nom }}</span>
                                    </div>
                                    <span class="badge bg-light text-primary rounded-pill border">{{ burger.total }} vdus</span>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="text-center py-4">
                            <p class="text-muted small">Aucune donnée disponible</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/dashboard.css') }}">
{% endblock %}

{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
const ctx = document.getElementById('statsChart');
new Chart(ctx, {
    type: 'line', // Changé en ligne pour un look plus moderne
    data: {
        labels: ['En cours', 'Validées', 'Annulées'],
        datasets: [{
            label: 'Commandes',
            data: [{{ resume.commandesEnCours }}, {{ resume.commandesValidees }}, {{ resume.commandesAnnulees }}],
            borderColor: '#0d6efd',
            backgroundColor: 'rgba(13, 110, 253, 0.1)',
            fill: true,
            tension: 0.4,
            pointRadius: 6,
            pointBackgroundColor: '#fff',
            pointBorderColor: '#0d6efd',
            pointBorderWidth: 2
        }]
    },
    options: {
        plugins: { legend: { display: false } },
        scales: {
            y: { beginAtZero: true, grid: { display: false } },
            x: { grid: { display: false } }
        }
    }
});
</script>
{% endblock %}