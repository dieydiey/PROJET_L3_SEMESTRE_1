{# templates/livraison/index.html.twig #}
{% extends 'base.html.twig' %}

{% block page_title %}
    <span class="d-inline-flex align-items-center justify-content-center rounded-circle me-2" style="width: 35px; height: 35px; background-color: #fef2f2;">
        <i class="bi bi-truck text-danger fs-5"></i>
    </span>
    Livraisons en attente
{% endblock %}

{% block body %}
<div class="container-fluid" style="margin-top:0;">
    <div class="row mb-3"> {# Marge du bas réduite de mb-4 à mb-3 #}
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 px-3 py-2 bg-white"> {# Padding réduit : p-3 à py-2 (haut/bas) #}

                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        {# Icône plus petite : p-3 à p-2 et fs-3 à fs-4 #}
                        <div class="flex-shrink-0 bg-light-danger p-2 rounded-3" style="background-color: #fef2f2;">
                            <i class="bi bi-clock-history fs-4 text-danger"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            {# Texte plus petit pour gagner de l'espace #}
                            <h6 class="text-muted mb-0 small fw-bold">Total en attente</h6>
                            <span class="h5 fw-bold mb-0">{{ livraisons|length }}</span> {# h4 à h5 #}
                        </div>
                    </div>

                    {# Bouton plus compact : py-1 et petit texte #}
                    <a href="{{ path('livraison_par_zone') }}"
                    class="btn btn-danger btn-sm px-3 py-1 rounded-pill fw-bold">
                        <i class="bi bi-geo-alt me-1"></i>
                        <small>Regrouper par zone</small>
                    </a>
                </div>

            </div>
        </div>
    </div>


    <div class="row g-3">
        {% for livraison in livraisons %}
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 h-100 livraison-card">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <span class="badge bg-light text-danger border border-danger-subtle rounded-pill mb-2">
                                    #{{ livraison.commande.numeroCommande }}
                                </span>
                                <h5 class="fw-bold mb-0">
                                    {{ livraison.commande.client.prenom }} {{ livraison.commande.client.nom }}
                                </h5>
                            </div>
                           
                        </div>

                        <div class="mb-3 text-muted">
                            <div class="d-flex align-items-center mb-1">
                                <i class="bi bi-geo-alt-fill me-2 text-secondary"></i>
                                <span class="small">{{ livraison.adresseLivraison|slice(0, 60) }}...</span>
                            </div>
                            <div class="d-flex align-items-center">
                                <i class="bi bi-telephone-fill me-2 text-secondary"></i>
                                <span class="small">{{ livraison.commande.client.telephone }}</span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <div class="text-danger fw-bold fs-5">
                                {{ livraison.commande.montantTotal|number_format(0, '.', ' ') }} FCFA
                            </div>
                            <span class="badge bg-{{ livraison.statut.getBadgeClass }} rounded-pill px-4 py-2 fs-6 shadow-sm">
                                {{ livraison.statut.getLabel }}
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="text-center py-5 bg-white rounded-4 shadow-sm">
                    <i class="bi bi-box2 fs-1 text-muted"></i>
                    <p class="mt-3 text-muted">Aucune livraison en attente pour le moment.</p>
                </div>
            </div>
        {% endfor %}
    </div>

    <div class="mt-2 d-flex justify-content-center">
        {% include 'components/pagination.html.twig' with {
            'totalPages': totalPages,
            'currentPage': currentPage
        } %}
    </div>
</div>

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/listeLivraison.css') }}">
{% endblock %}
{% endblock %}