{% extends 'base.html.twig' %}

{% block title %}Mon Profil - Brasil Burger{% endblock %}

{% block page_title %}Mon Profil{% endblock %}

{% block body %}
<div class="container-fluid">
    {# Affichage des messages de succès ou d'erreur #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'success' ? 'success' : 'danger' }} alert-dismissible fade show rounded-4 shadow-sm mb-4 border-0">
                <i class="bi {{ label == 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill' }} me-2"></i>
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="row">
        {# Colonne de gauche : Carte de visite #}
        <div class="col-lg-4 mb-4">
            <div class="card border-0 shadow-sm text-center p-4 rounded-4">
                <div class="avatar-circle mx-auto mb-3 bg-danger-soft text-danger d-flex align-items-center justify-content-center" 
                     style="width: 100px; height: 100px; font-size: 3rem; border-radius: 50%;">
                    <i class="bi bi-person-badge"></i>
                </div>
                <h4 class="fw-bold mb-1">{{ app.user.prenom }} {{ app.user.nom }}</h4>
                <p class="text-muted small mb-3">Gestionnaire Brasil Burger</p>
                <div class="badge badge-soft-success px-3 py-2">Compte Actif</div>
                
                <hr class="my-4 opacity-50">
                
                <div class="text-start">
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-envelope me-3 text-danger"></i>
                        <span class="text-truncate">{{ app.user.email }}</span>
                    </div>
                    <div class="d-flex align-items-center">
                        <i class="bi bi-phone me-3 text-danger"></i>
                        <span>{{ app.user.telephone|default('Non renseigné') }}</span>
                    </div>
                </div>
            </div>
        </div>

        {# Colonne de droite : Formulaire #}
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <ul class="nav nav-tabs card-header-tabs" id="profileTabs" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active fw-bold border-0 text-dark" id="info-tab" data-bs-toggle="tab" data-bs-target="#info" type="button">Informations</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link fw-bold border-0 text-dark" id="security-tab" data-bs-toggle="tab" data-bs-target="#security" type="button">Sécurité</button>
                        </li>
                    </ul>
                </div>
                
                <div class="card-body p-4">
                    {# Formulaire unique pointant vers la route d'update #}
                    <form action="{{ path('gestionnaire_profil_update') }}" method="POST">
                        <div class="tab-content" id="profileTabsContent">
                            
                            {# Onglet Informations #}
                            <div class="tab-pane fade show active" id="info" role="tabpanel">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">Prénom</label>
                                        <input type="text" name="prenom" class="form-control rounded-3" value="{{ app.user.prenom }}" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">Nom</label>
                                        <input type="text" name="nom" class="form-control rounded-3" value="{{ app.user.nom }}" required>
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label small fw-bold">Email</label>
                                        <input type="email" name="email" class="form-control rounded-3" value="{{ app.user.email }}" required>
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label small fw-bold">Téléphone</label>
                                        <input type="text" name="telephone" class="form-control rounded-3" value="{{ app.user.telephone }}">
                                    </div>
                                </div>
                            </div>

                            {# Onglet Sécurité #}
                            <div class="tab-pane fade" id="security" role="tabpanel">
                                <div class="row g-3">
                                    <div class="col-md-12">
                                        <div class="alert alert-warning small rounded-3 border-0">
                                            <i class="bi bi-info-circle me-2"></i>
                                            Laissez vide si vous ne souhaitez pas changer de mot de passe.
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label small fw-bold">Nouveau mot de passe</label>
                                        <input type="password" name="new_password" class="form-control rounded-3" placeholder="••••••••">
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 mt-4 pt-3 border-top">
                                <button type="submit" class="btn btn-bb px-5 py-2 shadow-sm">
                                    Mettre à jour mon profil
                                </button>
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/profil.css') }}">
{% endblock %}
{% endblock %}